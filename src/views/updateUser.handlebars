<div id="view-edit-users" class="py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">

      {{#if user}}
      <div class="mb-4">
        <a href="/users" class="text-decoration-none small text-secondary d-inline-flex align-items-center gap-1">
          <i class="bi bi-arrow-left"></i> Cancelar y volver
        </a>
        <h2 class="h3 fw-bold mt-2 mb-1">Actualizar Información</h2>
        <p class="text-secondary small">Modifique los atributos del perfil seleccionado.</p>
      </div>

      <div class="card border rounded-3 shadow-sm p-4 bg-body-tertiary">
        {{#with user}}
        <form id="form-edit-user">
          <div class="mb-3">
            <label for="idUser" class="form-label fw-semibold small text-secondary">ID Técnico (Read-Only)</label>
            <input type="text" class="form-control bg-body-secondary fw-mono" name="idUser" id="idUser" value="{{id}}" readonly required>
          </div>

          <div class="mb-3">
            <label for="firstname" class="form-label fw-semibold small">Nombre</label>
            <input type="text" class="form-control" name="firstname" id="firstname" value="{{firstname}}" required minlength="2">
          </div>

          <div class="mb-3">
            <label for="lastname" class="form-label fw-semibold small">Apellido</label>
            <input type="text" class="form-control" name="lastname" id="lastname" value="{{lastname}}" required minlength="2">
          </div>

          <div class="mb-4">
            <label for="email" class="form-label fw-semibold small">Correo Electrónico</label>
            <input type="email" class="form-control" name="email" id="email" value="{{email}}" required>
          </div>

          <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
            <a href="/users" class="btn btn-outline-secondary px-3"><i class="bi bi-x-circle me-1"></i> Cancelar</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-save me-1"></i> Guardar Cambios</button>
          </div>
        </form>
        {{/with}}
      </div>

      {{else}}
      <div class="card border rounded-3 text-center p-5 bg-body-tertiary shadow-sm">
        <div class="py-3">
          <i class="bi bi-exclamation-triangle fs-1 text-warning mb-2"></i>
          <h4 class="fw-bold">Registro No Encontrado</h4>
          <p class="text-secondary small mb-3">No existe ningún usuario asociado al identificador indicado.</p>
          <a href="/users" class="btn btn-primary btn-sm">Volver al Directorio</a>
        </div>
      </div>
      {{/if}}

    </div>
  </div>
</div>

<script defer src="/assets/js/updateUser.js"></script>