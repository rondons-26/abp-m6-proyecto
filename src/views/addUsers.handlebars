<div id="view-add-users" class="py-4">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
      
      <div class="mb-4">
        <a href="/users" class="text-decoration-none small text-secondary d-inline-flex align-items-center gap-1">
          <i class="bi bi-arrow-left"></i> Volver al directorio
        </a>
        <h2 class="h3 fw-bold mt-2 mb-1">Registrar Nuevo Usuario</h2>
        <p class="text-secondary small">Complete los campos obligatorios para ingresar una nueva cuenta al sistema.</p>
      </div>

      <div class="card border rounded-3 shadow-sm p-4 bg-body-tertiary">
        <form id="form-add-user">
          <div class="mb-3">
            <label for="firstname" class="form-label fw-semibold small">Nombre</label>
            <input type="text" class="form-control" name="firstname" id="firstname" placeholder="Ej. Juan" required minlength="2">
          </div>
          
          <div class="mb-3">
            <label for="lastname" class="form-label fw-semibold small">Apellido</label>
            <input type="text" class="form-control" name="lastname" id="lastname" placeholder="Ej. Pérez" required minlength="2">
          </div>
          
          <div class="mb-4">
            <label for="email" class="form-label fw-semibold small">Correo Electrónico</label>
            <input type="email" class="form-control" name="email" id="email" placeholder="juan.perez@empresa.com" required>
          </div>

          <div class="d-flex align-items-center justify-content-end gap-2 pt-2 border-top">
            <button type="reset" class="btn btn-outline-secondary px-3"><i class="bi bi-x-circle me-1"></i> Limpiar</button>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check-circle me-1"></i> Guardar Usuario</button>
          </div>
        </form>
      </div>

    </div>
  </div>
</div>

<script defer src="/assets/js/addUsers.js"></script>