<div id="view-status" class="py-4">
  <div class="mb-4">
    <h2 class="h3 fw-bold text-dark mb-1">Estado del Servidor</h2>
    <p class="text-muted small">Monitoreo en tiempo real de la instancia Node.js y Express.</p>
  </div>

  <div class="card border rounded-3 shadow-sm p-4 bg-white">
    <div class="row g-3">
      <div class="col-md-6">
        <div class="p-3 border rounded bg-light">
          <span class="text-muted small d-block">ESTADO OPERATIVO</span>
          <span class="fw-bold text-success fs-5">● {{status.status}}</span>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-3 border rounded bg-light">
          <span class="text-muted small d-block">TIEMPO ACTIVO (UPTIME)</span>
          <span class="fw-bold text-dark fs-5">{{status.uptime}}</span>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-3 border rounded bg-light">
          <span class="text-muted small d-block">ENTORNO</span>
          <span class="fw-bold text-dark fs-5">{{status.environment}}</span>
        </div>
      </div>
      <div class="col-md-6">
        <div class="p-3 border rounded bg-light">
          <span class="text-muted small d-block">VERSIÓN DE NODE</span>
          <span class="fw-bold text-dark fs-5">{{status.nodeVersion}}</span>
        </div>
      </div>
    </div>
  </div>
</div>